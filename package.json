{
  "name": "posttime-research-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:data": "node scripts/generate-vitepress-data.mjs",
    "docs:dev": "npm run docs:data && vitepress dev . --host 127.0.0.1",
    "docs:build": "npm run docs:data && vitepress build .",
    "docs:preview": "vitepress preview . --host 127.0.0.1"
  },
  "devDependencies": {
    "vitepress": "^1.6.4",
    "vue": "^3.5.13"
  }
}
